{
  "name": "atto-page",
  "version": "0.1.0",
  "private": true,
  "description": "ATTO_page —— 个人项目主页（校园规则怪谈等多项目入口）",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w client",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "sync": "node scripts/sync-scenes.mjs",
    "test:scene": "node scripts/smoke-scene.mjs"
  },
  "overrides": {
    "uWebSockets.js": "npm:ws@^8.18.0"
  }
}
